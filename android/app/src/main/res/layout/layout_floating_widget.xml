<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Expanded Floating Widget Window -->
    <LinearLayout
        android:id="@+id/widget_expanded_view"
        android:layout_width="320dp"
        android:layout_height="500dp"
        android:background="@drawable/widget_bg"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Top Drag Bar -->
        <RelativeLayout
            android:id="@+id/widget_drag_bar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:fontFamily="serif"
                android:text="✦ LIVE ASCII ROSE ✦"
                android:textColor="#FFB3C6"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_minimize"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="#FFAABF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_close"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#FF5577"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Interactive Real-Time ASCII Engine WebView -->
        <WebView
            android:id="@+id/widget_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="#000000" />
    </LinearLayout>

    <!-- Collapsed Floating Badge (When minimized to screen corner) -->
    <FrameLayout
        android:id="@+id/widget_collapsed_view"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/badge_bg"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="🌹"
            android:textSize="26sp" />
    </FrameLayout>
</FrameLayout>
